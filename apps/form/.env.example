# Server-side only. Set these in Vercel → Project → Settings → Environment Variables.
# Never prefix them with VITE_: anything with that prefix is bundled into the browser.

# Food recognition (required for photo logging)
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=

# Private passcode. Your phone sends it with each API call; requests without it are refused.
APP_ACCESS_CODE=

# Background alarms (optional). Generate keys with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Upstash Redis REST credentials (free tier) used to store the alarm schedule
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secret the minute-by-minute scheduler sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
